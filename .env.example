# Coral Sources 

# GitHub (https://github.com/settings/tokens)
# Scopes needed: repo, read:org
GITHUB_TOKEN=ghp_

# Sentry (https://sentry.io/settings/account/api/auth-tokens/)
SENTRY_TOKEN=
# Sentry org slug — found in your URL: sentry.io/organizations/THIS-PART/
SENTRY_ORG=

# Datadog (https://app.datadoghq.com/organization-settings/api-keys)
DD_API_KEY=
# Datadog Application key (different from API key)
DD_APPLICATION_KEY=

# Slack Bot Token (https://api.slack.com/apps → OAuth & Permissions)
# Scopes needed: channels:history, channels:read, users:read
SLACK_BOT_TOKEN=xoxb-

# Langfuse (https://cloud.langfuse.com → Settings → API Keys)
# Cloud regions: EU=https://cloud.langfuse.com  US=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-

# Groq API key (https://console.groq.com/keys)
# Used by the narrator to generate incident reports, risk summaries, and digests.
# Recommended model: llama-3.3-70b-versatile
GROQ_API_KEY=gsk_

# Groq model to use for narration (can override without code changes)
GROQ_MODEL=llama-3.3-70b-versatile

# ── GitHub Target Repo 

# The org/user and repo Sentinel watches for commits, PRs, and issues
GITHUB_OWNER=
GITHUB_REPO=

#  Slack Channels 

# Channel where Sentinel posts incident reports and weekly digests
SLACK_INCIDENTS_CHANNEL=#incidents

#  Agent Thresholds 

# Cost spike: alert when hourly cost exceeds this multiple of the 7-day avg
COST_SPIKE_MULTIPLIER=2.5

# PR risk: auto-request-changes when risk score exceeds this value (0–100)
PR_RISK_THRESHOLD=70

# Agent loop: alert when a single trace exceeds this many generations in 1h
AGENT_LOOP_GENERATION_THRESHOLD=10
